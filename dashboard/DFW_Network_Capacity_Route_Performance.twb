  <worksheets>
    <worksheet name='DFW Passenger Volume by Reporting Carrier'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='11'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dfw_route_performance_analytics' name='federated.0pz7fid0twx38u115uenj1vw47gd' />
          </datasources>
          <datasource-dependencies datasource='federated.0pz7fid0twx38u115uenj1vw47gd'>
            <column caption='Load Factor' datatype='real' default-format='p0.00%' name='[Calculation_4628301567057920]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([seats]) &gt; 0 THEN&#10;    SUM([passengers])/SUM([seats])&#10;END' />
            </column>
            <column caption='Is DFW Route' datatype='boolean' name='[Calculation_4628301569376260]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[origin] = &quot;DFW&quot; OR [dest] = &quot;DFW&quot;' />
            </column>
            <column caption='DFW Direction' datatype='string' name='[Calculation_4628301569839109]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [origin] = &quot;DFW&quot; THEN &quot;Outbound&quot;&#10;ELSEIF [dest] = &quot;DFW&quot; THEN &quot;Inbound&quot;&#10;END' />
