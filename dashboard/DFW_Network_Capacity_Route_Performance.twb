    <worksheet name='Route Opportunity'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Tableau Regular' fontsize='12'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='dfw_route_performance_analytics' name='federated.0pz7fid0twx38u115uenj1vw47gd' />
          </datasources>
          <datasource-dependencies datasource='federated.0pz7fid0twx38u115uenj1vw47gd'>
            <column caption='Passengers 2026 YTD' datatype='integer' name='[Calculation_3437601052778496]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#10;    IF YEAR([service_month])= 2026&#10;    AND MONTH([service_month]) &lt;=5&#10;    THEN [passengers]&#10;    END&#10;)' />
            </column>
            <column caption='YoY Passenger Growth' datatype='real' default-format='p0.00%' name='[Calculation_3437601053642754]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Passengers 2026 YTD (copy)_3437601053188097] &gt; 0 THEN&#10;   ([Calculation_3437601052778496] - [Passengers 2026 YTD (copy)_3437601053188097])&#10;    /[Passengers 2026 YTD (copy)_3437601053188097]&#10;END' />
            </column>
            <column caption='Comparison Eligible' datatype='boolean' name='[Calculation_3437601087496196]' role='measure' type='nominal'>
              <calculation class='tableau' formula='NOT ISNULL([Passengers 2026 YTD (copy)_3437601053188097])&#10;AND [Passengers 2026 YTD (copy)_3437601053188097] &gt; 0&#10;AND NOT ISNULL([Calculation_3437601052778496])' />
            </column>
            <column caption='AA DFW Load Factor Benchmark' datatype='real' default-format='p0.00%' name='[Calculation_3437601298595847]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED :&#10;    SUM(&#10;        IF [unique_carrier_name] = &quot;American Airlines Inc.&quot;&#10;        AND [Calculation_4628301569376260] = TRUE&#10;        AND YEAR([service_month]) = 2026&#10;        AND MONTH([service_month]) &lt;= 5&#10;        THEN [passengers]&#10;        END&#10;    )&#10;    /&#10;    SUM(&#10;        IF [unique_carrier_name] = &quot;American Airlines Inc.&quot;&#10;        AND [Calculation_4628301569376260] = TRUE&#10;        AND YEAR([service_month]) = 2026&#10;        AND MONTH([service_month]) &lt;= 5&#10;        THEN [seats]&#10;        END&#10;    )&#10;}' />
            </column>
            <column caption='Planning Conditions' datatype='string' name='[Calculation_3437601302708232]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_3437601053642754] &gt;= 0&#10;AND [Calculation_4628301567057920] &gt;= AVG([Calculation_3437601298595847])&#10;THEN &quot;Capacity Pressure&quot;&#10;&#10;ELSEIF [Calculation_3437601053642754] &lt; 0&#10;AND [Calculation_4628301567057920] &lt; AVG([Calculation_3437601298595847])&#10;THEN &quot;Potential Excess Capacity&quot;&#10;&#10;ELSEIF [Calculation_3437601053642754] &gt;= 0&#10;AND [Calculation_4628301567057920] &lt; AVG([Calculation_3437601298595847])&#10;THEN &quot;Capacity Ahead of Demand&quot;&#10;&#10;ELSE&#10;    &quot;Monitor / Investigate&quot;&#10;END' />
            </column>
            <column caption='Load Factor' datatype='real' default-format='p0.00%' name='[Calculation_4628301567057920]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([seats]) &gt; 0 THEN&#10;    SUM([passengers])/SUM([seats])&#10;END' />
            </column>
            <column caption='Departure Variance' datatype='real' datatype-customized='true' default-format='n#,##0;-#,##0' name='[Calculation_4628301567860737]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT(SUM([departures_performed]) - SUM([departures_scheduled]))' />
