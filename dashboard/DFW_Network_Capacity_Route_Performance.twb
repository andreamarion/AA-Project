            <column caption='Seats' datatype='integer' name='[seats]' role='measure' type='quantitative' />
            <column caption='Service Month' datatype='date' name='[service_month]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_3437601053642754]' derivation='User' name='[usr:Calculation_3437601053642754:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0pz7fid0twx38u115uenj1vw47gd].[Action (DFW Market)]'>
            <groupfilter function='level-members' level='[Calculation_4628301575823366]' user:ui-action-filter='[Action1_FEBD41782FE6425A8D50E08CB7641137]' user:ui-enumeration='all' user:ui-marker='enumerate' />
